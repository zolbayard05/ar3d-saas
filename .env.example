# ==============================================================================
# Copy to .env.local and fill in. Vars WITHOUT NEXT_PUBLIC_ are server-only —
# never referenced from a "use client" component (see lib/supabase/admin.ts
# for how that's enforced for the Supabase secret key).
# ==============================================================================

# ---- Supabase (Phase 1) -----------------------------------------------------
# Project URL and public API keys — Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable" key (current naming; the legacy equivalent is the anon key —
# both work today, Supabase is mid-migration off anon/service_role naming).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (current naming; legacy equivalent: service_role key).
# SERVER-ONLY. Bypasses RLS. Only imported via lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=

# ---- Cloudflare R2 (Phase 2) -------------------------------------------------
# R2 dashboard > Manage API Tokens. Scope the token to the two buckets below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket for raw user-uploaded source photos.
R2_UPLOADS_BUCKET=uploads
# Public bucket for generated .glb/.usdz model files.
R2_MODELS_BUCKET=models
# Custom domain (cdn.<yourdomain>) fronting R2_MODELS_BUCKET — never serve
# models from the rate-limited *.r2.dev domain in production. Requires a DNS
# CNAME to the bucket's public development URL or an R2 custom domain binding
# (see README "R2 setup" section once Phase 2 lands).
NEXT_PUBLIC_MODELS_CDN_URL=

# ---- Tripo (Image -> 3D provider) (Phase 3) ----------------------------------
TRIPO_API_KEY=
# Public base URL of this deployment, used to build the webhook callback_url
# Tripo posts generation results to (e.g. https://yourapp.vercel.app).
NEXT_PUBLIC_APP_URL=

# ---- Stripe (Phase 6) --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
